@page "/edi-reader"
@using EdiX12Reader.Models
@using EdiX12Reader.Services
@inject EdiX12Parser Parser

<PageTitle>EDI X12 Reader</PageTitle>

<h1>EDI X12 Reader</h1>
<p>Upload and parse EDI X12 format files (837 Healthcare Claim & 835 Payment/Remittance)</p>

<div class="mb-3">
    <label class="form-label">Paste EDI X12 Content:</label>
    <textarea class="form-control" rows="10" @bind="ediContent" placeholder="Paste your EDI X12 content here..."></textarea>
</div>

<div class="mb-3">
    <button class="btn btn-primary" @onclick="ParseEdi">Parse EDI</button>
    <button class="btn btn-secondary ms-2" @onclick="ClearContent">Clear</button>
    <button class="btn btn-info ms-2" @onclick="LoadSample837">Load Sample 837</button>
    <button class="btn btn-info ms-2" @onclick="LoadSample835">Load Sample 835</button>
</div>

@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger" role="alert">
        <strong>Error:</strong> @errorMessage
    </div>
}

@if (parsedDocument != null)
{
    <div class="card mb-3">
        <div class="card-header bg-success text-white">
            <h5>Document Information</h5>
        </div>
        <div class="card-body">
            <table class="table table-sm">
                <tbody>
                    <tr>
                        <td><strong>Document Type:</strong></td>
                        <td>@parsedDocument.DocumentType</td>
                    </tr>
                    <tr>
                        <td><strong>Sender ID:</strong></td>
                        <td>@parsedDocument.SenderId</td>
                    </tr>
                    <tr>
                        <td><strong>Receiver ID:</strong></td>
                        <td>@parsedDocument.ReceiverId</td>
                    </tr>
                    <tr>
                        <td><strong>Interchange Control Number:</strong></td>
                        <td>@parsedDocument.InterchangeControlNumber</td>
                    </tr>
                    <tr>
                        <td><strong>Transaction Set Control Number:</strong></td>
                        <td>@parsedDocument.TransactionSetControlNumber</td>
                    </tr>
                    <tr>
                        <td><strong>Total Segments:</strong></td>
                        <td>@parsedDocument.Segments.Count</td>
                    </tr>
                    <tr>
                        <td><strong>Parsed Date:</strong></td>
                        <td>@parsedDocument.ParsedDate.ToString("yyyy-MM-dd HH:mm:ss")</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>

    <div class="card">
        <div class="card-header bg-primary text-white">
            <h5>Segments Detail</h5>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-striped table-hover">
                    <thead>
                        <tr>
                            <th style="width: 50px;">Line</th>
                            <th style="width: 100px;">Segment ID</th>
                            <th style="width: 250px;">Description</th>
                            <th>Elements</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var segment in parsedDocument.Segments)
                        {
                            <tr>
                                <td>@segment.LineNumber</td>
                                <td><span class="badge bg-info">@segment.SegmentId</span></td>
                                <td>@GetSegmentDescription(segment.SegmentId)</td>
                                <td>
                                    <small>
                                        @for (int i = 0; i < segment.Elements.Count; i++)
                                        {
                                            <span class="me-2">
                                                <strong>[@(i + 1)]:</strong> @segment.Elements[i]
                                            </span>
                                            @if ((i + 1) % 3 == 0)
                                            {
                                                <br />
                                            }
                                        }
                                    </small>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}

@code {
    private string ediContent = string.Empty;
    private EdiDocument? parsedDocument;
    private string errorMessage = string.Empty;

    private void ParseEdi()
    {
        try
        {
            errorMessage = string.Empty;
            parsedDocument = Parser.ParseEdiContent(ediContent);
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
            parsedDocument = null;
        }
    }

    private void ClearContent()
    {
        ediContent = string.Empty;
        parsedDocument = null;
        errorMessage = string.Empty;
    }

    private string GetSegmentDescription(string segmentId)
    {
        var descriptions = Parser.GetSegmentDescription(segmentId);
        return descriptions.ContainsKey(segmentId) ? descriptions[segmentId] : "Unknown Segment";
    }

    private void LoadSample837()
    {
        // Sample EDI 837 Professional Healthcare Claim
        ediContent = @"ISA*00*          *00*          *ZZ*SUBMITTER      *ZZ*RECEIVER       *230101*1200*^*00501*000000001*0*P*:~
